
{
  "name": "bora-cume-hub-desktop",
  "version": "1.0.1",
  "author": "BoraCumê Team",
  "description": "Desktop application for Bora Cume Hub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish=never",
    "build-win": "electron-builder --win --publish=never",
    "build-mac": "electron-builder --mac --publish=never",
    "build-linux": "electron-builder --linux --publish=never",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "electron-builder install-app-deps && npm run rebuild"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "serialport": "^12.0.0",
    "node-thermal-printer": "^4.5.0",
    "ws": "^8.19.0"
  },
  "build": {
    "asar": false,
    "appId": "com.boracume.desktop",
    "productName": "BoraCume",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "services/**/*",
      "config/**/*",
      "node_modules/**/*",
      "main.js",
      "preload.js",
      "server.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32"]
        },
        {
          "target": "portable",
          "arch": ["ia32"]
        }
      ],
      "executableName": "BoraCume",
      "icon": "../public/icon-512x512.png",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": false,
      "runAfterFinish": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  }
}
