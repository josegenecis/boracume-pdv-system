{
  "name": "bora-cume-hub-desktop",
  "version": "1.0.5",
  "author": "BoraCumê Team",
  "description": "Desktop application for Bora Cume Hub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish=never",
    "build-win": "electron-builder --win --publish=never",
    "build-win:publish": "electron-builder --win --publish=always",
    "build-mac": "electron-builder --mac --publish=never",
    "build-linux": "electron-builder --linux --publish=never",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "electron-builder install-app-deps && npm run rebuild"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "serialport": "^12.0.0",
    "node-thermal-printer": "^4.5.0",
    "ws": "^8.19.0"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "compression": "maximum",
    "appId": "com.boracume.desktop",
    "productName": "BoraCume",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!dist/electron-dist/**",
      "!dist/**/electron-dist/**",
      "services/**/*",
      "config/**/*",
      "main.js",
      "preload.js",
      "server.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "executableName": "BoraCume",
      "icon": "../public/icon-512x512.png",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": false,
      "runAfterFinish": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "josegenecis",
        "repo": "boracume-pdv-system"
      }
    ],
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  }
}
