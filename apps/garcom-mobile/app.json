{
  "expo": {
    "name": "BoraCumê Garçom",
    "slug": "boracume-garcom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-garcom.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/app-garcom.png",
      "resizeMode": "contain",
      "backgroundColor": "#003223"
    },
    "ios": {
      "bundleIdentifier": "com.boracume.garcom",
      "supportsTablet": true
    },
    "android": {
      "package": "com.boracume.garcom",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-garcom.png",
        "backgroundColor": "#003223"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "projectName": "boracume-garcom"
    }
  }
}
